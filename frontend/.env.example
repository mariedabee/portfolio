# Copy to .env.local for local development (git-ignored).
# On Vercel, set these under Project Settings -> Environment Variables.

# Contact form email: either Resend (HTTP API, works on Railway) ...
# Free key at https://resend.com/api-keys. Without a verified domain, Resend only
# delivers to the email address of your Resend account.
RESEND_API_KEY=
# Optional: sender once your domain is verified in Resend, e.g. Portfolio <hello@yourdomain>
EMAIL_FROM=

# ... or SMTP (Gmail: create an App Password at https://myaccount.google.com/apppasswords).
# Many hosts, including Railway, block SMTP, so use Resend there.
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-16-character-app-password
# Optional: where messages are delivered (defaults to EMAIL_USER)
EMAIL_TO=
# Optional: other SMTP providers
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465

# Optional: also store messages in MongoDB (e.g. a free MongoDB Atlas cluster)
MONGODB_URI=
